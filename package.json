{
  "name": "pi-skillful",
  "version": "0.1.0",
  "description": "Pi package with skill invocation and visibility improvements.",
  "type": "module",
  "license": "MIT",
  "author": "jvm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvm/pi-skillful.git"
  },
